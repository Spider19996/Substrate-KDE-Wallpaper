msgstr "Приостанавливать, когда:"

msgid "Pausing keeps the picture as it is and costs no power. Drawing continues where it stopped."
msgstr "При паузе картинка остаётся как есть и энергия не расходуется. Рисование продолжится с того же места."

msgid "Performance"
msgstr "Производительность"

msgid "Perpendicular (90°)"
msgstr "Перпендикулярно (90°)"

msgid "Power"
msgstr "Питание"

msgid "Preview"
msgstr "Предпросмотр"

