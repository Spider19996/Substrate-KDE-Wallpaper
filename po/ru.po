msgstr "Обе стороны"

msgid "Branching"
msgstr "Ветвление"

msgid "Built-in collections take no new themes. Use \"Duplicate\" to make an own copy of this theme."
msgstr "Встроенные коллекции не принимают новые темы. Используйте «Дублировать», чтобы сделать собственную копию этой темы."

msgid "Built-in themes are not changed. Saving stores your version in your own theme folder, which then replaces the built-in one."
msgstr "Встроенные темы не изменяются. При сохранении ваша версия попадает в вашу папку тем и заменяет встроенную."

msgid "Built-in themes cannot be moved, a copy was created in \"%1\"."
msgstr "Встроенные темы нельзя перемещать, копия создана в «%1»."

msgid "Cancel"
msgstr "Отмена"

msgid "Chance per impact (%)"
msgstr "Вероятность при столкновении (%)"

msgid "Choose which collections and themes run on your desktop. Tick a whole collection or single themes from it. The ticked ones take turns at every reset. If nothing is ticked, all themes run."
msgstr "Выберите, какие коллекции и темы будут работать на рабочем столе. Отметьте всю коллекцию или отдельные темы из неё. Отмеченные сменяют друг друга при каждом сбросе. Если ничего не отмечено, работают все темы."

msgid "Choose…"
msgstr "Выбрать…"

msgid "Clear defaults"
msgstr "Очистить значения по умолчанию"

msgid "Close"
msgstr "Закрыть"

msgid "Collapse"
msgstr "Свернуть"

msgid "Collection name:"
msgstr "Название коллекции:"

msgid "Collection:"
msgstr "Коллекция:"

