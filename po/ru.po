msgstr "Удалить коллекцию"

msgid "Delete the collection with your own themes and subcollections in it"
msgstr "Удалить коллекцию вместе с вашими темами и подколлекциями в ней"

msgid "Delete the selected theme"
msgstr "Удалить выбранную тему"

msgid "Delete the theme \"%1\"?"
msgstr "Удалить тему «%1»?"

msgid "Delete theme"
msgstr "Удалить тему"

msgid "Delete your collection \"%1\" with its defaults, all its own themes and all its subcollections? Built-in themes of the same collection stay."
msgstr "Удалить вашу коллекцию «%1» с её значениями по умолчанию, всеми собственными темами и подколлекциями? Встроенные темы этой же коллекции останутся."

msgid "Disable built-in themes"
msgstr "Отключить встроенные темы"

msgid "Discard the changes to \"%1\"?"
msgstr "Отменить изменения в «%1»?"

msgid "Discard the changes to the defaults of \"%1\"?"
msgstr "Отменить изменения значений по умолчанию для «%1»?"

msgid "Drift"
msgstr "Дрейф"

msgid "Drift per event (°)"
msgstr "Дрейф за событие (°)"

msgid "Drift probability per step"
msgstr "Вероятность дрейфа за шаг"

