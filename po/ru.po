msgid "%1 FPS"
msgstr "%1 кадр/с"

msgid "%1 steps/s"
msgstr "%1 шагов/с"

msgid "(top level)"
msgstr "(верхний уровень)"

msgid "All collections"
msgstr "Все коллекции"

msgid "Animation speed:"
msgstr "Скорость анимации:"

msgid "Answer a few questions and let the rest be rolled"
msgstr "Ответьте на несколько вопросов, остальное будет выбрано случайно"

msgid "Anti-aliasing"
msgstr "Сглаживание"

msgid "Around the Plasma accent color"
msgstr "Вокруг акцентного цвета Plasma"

