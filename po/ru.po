msgstr "Редко"

msgid "Remove all defaults of this collection"
msgstr "Удалить все значения по умолчанию этой коллекции"

msgid "Remove all own values, the theme then looks like its collection"
msgstr "Удалить все собственные значения, тема тогда будет выглядеть как её коллекция"

msgid "Remove color"
msgstr "Удалить цвет"

msgid "Remove your version of \"%1\" and use the built-in one again?"
msgstr "Удалить вашу версию «%1» и снова использовать встроенную?"

msgid "Reset"
msgstr "Сбросить"

msgid "Reset at coverage (%)"
msgstr "Сброс при заполнении (%)"

msgid "Reset theme"
msgstr "Сбросить тему"

msgid "Reset to built-in"
msgstr "Вернуть встроенную"

msgid "Resolution:"
msgstr "Разрешение:"

