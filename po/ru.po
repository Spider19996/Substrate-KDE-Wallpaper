msgstr "Цвета"

msgid "Colors:"
msgstr "Цвета:"

msgid "Complementary"
msgstr "Дополнительные"

msgid "Cool"
msgstr "Холодные"

msgid "Copy \"%1\" with its defaults, themes and subcollections to a new collection of your own. Use a path like \"parent/name\" to put it into another collection."
msgstr "Копировать «%1» с её значениями по умолчанию, темами и подколлекциями в новую собственную коллекцию. Укажите путь вида «родитель/имя», чтобы поместить её в другую коллекцию."

msgid "Copy the selected theme"
msgstr "Копировать выбранную тему"

msgid "Copy the whole collection"
msgstr "Копировать всю коллекцию"

msgid "Create %1 themes"
msgstr "Создать тем: %1"

msgid "Create theme"
msgstr "Создать тему"

msgid "Curved cracks (%)"
msgstr "Изогнутые трещины (%)"

msgid "Curved lines:"
msgstr "Изогнутые линии:"

msgid "Dark tone"
msgstr "Тёмный тон"

msgid "Defaults of \"%1\""
msgstr "Значения по умолчанию для «%1»"

